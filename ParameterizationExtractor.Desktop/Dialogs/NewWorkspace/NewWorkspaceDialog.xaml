<mah:MetroWindow x:Class="Quipu.ParameterizationExtractor.Desktop.Dialogs.NewWorkspace.NewWorkspaceDialog"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:editor="clr-namespace:Quipu.ParameterizationExtractor.Desktop.Controls.ConnectionEditor"
                 Title="{Binding Title}"
                 Height="520" Width="640"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowCloseButton="True">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Workspace name (new mode only) -->
      <RowDefinition Height="Auto"/>  <!-- Save to (new mode only) -->
      <RowDefinition Height="Auto"/>  <!-- Source connection header -->
      <RowDefinition Height="*"/>     <!-- ConnectionEditor -->
      <RowDefinition Height="Auto"/>  <!-- Buttons -->
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Visibility="{Binding IsNewMode, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Workspace name:" Margin="0,4" VerticalAlignment="Center" Opacity="0.7"/>
      <TextBox   Grid.Column="1" Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
    </Grid>

    <Grid Grid.Row="1"
          Visibility="{Binding IsNewMode, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Save to:" Margin="0,4" VerticalAlignment="Center" Opacity="0.7"/>
      <TextBox   Grid.Column="1" Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
      <Button    Grid.Column="2" Content="…" Command="{Binding BrowseSavePathCommand}"
                 Padding="14,4" Margin="4,4,0,4"/>
    </Grid>

    <Separator Grid.Row="2" Margin="0,12,0,4"/>

    <editor:ConnectionEditorView Grid.Row="3"
                                 DataContext="{Binding ConnectionEditor}"/>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Cancel"
              Command="{Binding CancelCommand}"
              Padding="20,4"
              Margin="0,0,8,0"
              IsCancel="True"/>
      <Button Content="{Binding ConfirmButtonText}"
              Command="{Binding ConfirmCommand}"
              Padding="20,4"
              IsDefault="True"/>
    </StackPanel>
  </Grid>
</mah:MetroWindow>
