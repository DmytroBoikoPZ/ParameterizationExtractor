<mah:MetroWindow x:Class="Quipu.ParameterizationExtractor.Desktop.Dialogs.AddStandaloneTable.AddStandaloneTableDialog"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Add standalone table"
                 Height="220" Width="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowCloseButton="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Pick a table to add to extraction (outside the FK graph)."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <ComboBox Grid.Row="1"
                  ItemsSource="{Binding Tables}"
                  SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  TextSearch.TextPath="Name"
                  Margin="0,0,0,12">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Schema}" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        <TextBlock Text="."/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="20,4"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Add"
                    Command="{Binding ConfirmCommand}"
                    Padding="20,4"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
