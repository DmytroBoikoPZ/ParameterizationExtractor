<UserControl x:Class="Quipu.ParameterizationExtractor.Desktop.Controls.ConnectionEditor.ConnectionEditorView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Quipu.ParameterizationExtractor.Desktop.Controls.ConnectionEditor">
  <Grid Margin="0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Server -->
      <RowDefinition Height="Auto"/>  <!-- Database -->
      <RowDefinition Height="Auto"/>  <!-- Auth radios -->
      <RowDefinition Height="Auto"/>  <!-- User -->
      <RowDefinition Height="Auto"/>  <!-- Password -->
      <RowDefinition Height="Auto"/>  <!-- Store credentials -->
      <RowDefinition Height="Auto"/>  <!-- Test button + status -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" Margin="0,4" VerticalAlignment="Center" Opacity="0.7"/>
    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" Margin="0,4" VerticalAlignment="Center" Opacity="0.7"/>
    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Auth:" Margin="0,4" VerticalAlignment="Center" Opacity="0.7"/>
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
      <RadioButton Content="Windows" IsChecked="{Binding IsWindowsAuth}" Margin="0,0,16,0"/>
      <RadioButton Content="SQL"     IsChecked="{Binding IsSqlAuth}"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Grid.Column="0" Text="User:" Margin="0,4" VerticalAlignment="Center" Opacity="0.7"
               Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}"/>
    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
               Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}"/>

    <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" Margin="0,4" VerticalAlignment="Center" Opacity="0.7"
               Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}"/>
    <PasswordBox Grid.Row="4" Grid.Column="1" Margin="0,4"
                 local:PasswordBoxBindingBehavior.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}"/>

    <CheckBox Grid.Row="5" Grid.Column="1"
              Content="Store credentials (DPAPI-encrypted in the workspace file)"
              IsChecked="{Binding StoreCredentials}"
              Margin="0,4"
              Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}"/>

    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Test connection"
              Command="{Binding TestCommand}"
              IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolToVis}, ConverterParameter=enabled}"
              Padding="14,4"
              Margin="0,0,8,0"
              Visibility="{Binding IsTesting, Converter={StaticResource InverseBoolToVis}}"/>
      <Button Content="Cancel"
              Command="{Binding TestCancelCommand}"
              Padding="14,4"
              Margin="0,0,8,0"
              Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
