<UserControl x:Class="Quipu.ParameterizationExtractor.Desktop.Views.Graph.NodeInspectorView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strategy="clr-namespace:Quipu.ParameterizationExtractor.Desktop.Controls.StrategyPicker"
             xmlns:whereEditor="clr-namespace:Quipu.ParameterizationExtractor.Desktop.Controls.WhereFilterEditor">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Binding Node.Display}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="  •" Margin="6,0" Opacity="0.4" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Node.State}" Opacity="0.7" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 2. Strategy -->
        <TextBlock Grid.Row="1" Text="Strategy" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <strategy:StrategyPickerView Grid.Row="2"
                                     StrategyChoice="{Binding StrategyChoice, Mode=TwoWay}"
                                     Margin="0,0,0,12"/>

        <!-- 3. Where filter -->
        <TextBlock Grid.Row="3" Text="Where filter" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <whereEditor:WhereFilterEditorView Grid.Row="4"
                                           Text="{Binding Where, Mode=TwoWay}"
                                           Margin="0,0,0,12"/>

        <!-- 4. Excluded -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <CheckBox IsChecked="{Binding Excluded, Mode=TwoWay}" Content="Exclude from extraction"/>
            <TextBlock Text="When checked, this table is skipped during the FK walk and emits no SQL."
                       FontStyle="Italic" Opacity="0.55" Margin="22,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 5+6. Buttons -->
        <StackPanel Grid.Row="7" Orientation="Vertical">
            <Button Content="Add to extract"
                    Command="{Binding AddToExtractCommand}"
                    Visibility="{Binding IsAddable, Converter={StaticResource BoolToVis}}"
                    Padding="14,6" Margin="0,0,0,8"/>
            <Button Content="Recompute graph"
                    Command="{Binding RecomputeGraphCommand}"
                    ToolTip="Re-walk the FK graph against the updated workspace."
                    Padding="14,6"/>
        </StackPanel>
    </Grid>
</UserControl>
