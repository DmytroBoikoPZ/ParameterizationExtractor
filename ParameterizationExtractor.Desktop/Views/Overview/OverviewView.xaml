<UserControl x:Class="Quipu.ParameterizationExtractor.Desktop.Views.Overview.OverviewView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="{Binding WorkspaceName}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Source:" Margin="0,3" Opacity="0.7"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceSummary}" Margin="0,3"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed:" Margin="0,3" Opacity="0.7"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SeedSummary}" Margin="0,3"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Path:" Margin="0,3" Opacity="0.7"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PathSummary}" Margin="0,3"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Extras:" Margin="0,3" Opacity="0.7"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExtrasSummary}" Margin="0,3"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Last dry-run:" Margin="0,3" Opacity="0.7"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastDryRunSummary}" Margin="0,3"/>
      </Grid>

      <TextBlock Text="{Binding PendingWarning}"
                 Foreground="DarkOrange"
                 Margin="0,16,0,0"
                 TextWrapping="Wrap"/>

      <TextBlock Text="{Binding EmptyStateMessage}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                 Margin="0,24,0,0"
                 Opacity="0.7"
                 FontStyle="Italic"
                 TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
